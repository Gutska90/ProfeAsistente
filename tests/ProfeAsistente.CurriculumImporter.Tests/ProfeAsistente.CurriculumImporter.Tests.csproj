<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ProfeAsistente.CurriculumImporter\ProfeAsistente.CurriculumImporter.csproj" />
    <ProjectReference Include="..\..\src\ProfeAsistente.Shared\ProfeAsistente.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\src\ProfeAsistente.CurriculumImporter\samples\**\*" Link="samples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\ProfeAsistente.CurriculumImporter\Configuration\ParserProfiles\**\*" Link="Configuration\ParserProfiles\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
