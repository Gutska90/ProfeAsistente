<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppEducativa.Maui.ViewModels.Documents"
             x:Class="AppEducativa.Maui.Views.Documents.EducationalItemEditorPage"
             x:DataType="vm:EducationalItemEditorViewModel"
             Title="Editar ítem">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">
            <Label Text="{Binding MensajeEstado}" />
            <Label Text="Enunciado" FontAttributes="Bold" />
            <Editor Text="{Binding Statement}" AutoSize="TextChanges" MinimumHeightRequest="80" />
            <Label Text="Respuesta esperada" />
            <Editor Text="{Binding ExpectedAnswer}" AutoSize="TextChanges" MinimumHeightRequest="60" />
            <Label Text="Explicación" />
            <Editor Text="{Binding Explanation}" AutoSize="TextChanges" MinimumHeightRequest="60" />
            <Label Text="Puntaje" />
            <Entry Text="{Binding Points}" Keyboard="Numeric" />
            <Button Text="Guardar" Command="{Binding GuardarCommand}" BackgroundColor="#4A7C59" TextColor="White" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
