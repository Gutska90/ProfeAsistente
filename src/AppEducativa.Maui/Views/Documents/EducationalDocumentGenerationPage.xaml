<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppEducativa.Maui.ViewModels.Documents"
             x:Class="AppEducativa.Maui.Views.Documents.EducationalDocumentGenerationPage"
             x:DataType="vm:EducationalDocumentGenerationViewModel"
             Title="Crear material">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Crear material" Style="{StaticResource TitleLabel}"/>
            <Label Text="{Binding MensajeEstado}" Style="{StaticResource CaptionLabel}" LineBreakMode="WordWrap"/>
            <Label Text="Contexto curricular" FontAttributes="Bold"/>
            <Label Text="{Binding ContextoCurricular}" Style="{StaticResource CaptionLabel}" LineBreakMode="WordWrap"/>

            <Label Text="Tipo" FontAttributes="Bold"/>
            <CollectionView ItemsSource="{Binding TiposDocumento}" SelectedItem="{Binding TipoSeleccionado}"
                            SelectionMode="Single" HeightRequest="48">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeThickness="1" Stroke="#CCC" Padding="12,8"
                                StrokeShape="RoundRectangle 8" BackgroundColor="#F7F7F7">
                            <Label Text="{Binding .}" VerticalOptions="Center"/>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Dificultad" FontAttributes="Bold"/>
            <CollectionView ItemsSource="{Binding Dificultades}" SelectedItem="{Binding Difficulty}"
                            SelectionMode="Single" HeightRequest="48">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeThickness="1" Stroke="#CCC" Padding="12,8"
                                StrokeShape="RoundRectangle 8" BackgroundColor="#F7F7F7">
                            <Label Text="{Binding .}" VerticalOptions="Center"/>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Cantidad de ítems"/>
            <Entry Text="{Binding ItemCount}" Keyboard="Numeric"/>
            <Label Text="Duración estimada (min)"/>
            <Entry Text="{Binding EstimatedDurationMinutes}" Keyboard="Numeric"/>
            <HorizontalStackLayout Spacing="8">
                <CheckBox IsChecked="{Binding IncludeAnswerKey}"/>
                <Label Text="Incluir clave" VerticalOptions="Center"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="8">
                <CheckBox IsChecked="{Binding IncludeFeedback}"/>
                <Label Text="Incluir retroalimentación" VerticalOptions="Center"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="8">
                <CheckBox IsChecked="{Binding IncludeScoring}"/>
                <Label Text="Incluir puntaje" VerticalOptions="Center"/>
            </HorizontalStackLayout>
            <Label Text="Instrucciones del profesor"/>
            <Editor Text="{Binding TeacherInstructions}" AutoSize="TextChanges" MinimumHeightRequest="70"/>

            <Button Text="Generar" Command="{Binding GenerarCommand}" IsEnabled="{Binding CanGenerate}"/>
            <Button Text="Cancelar" Command="{Binding CancelarCommand}" Style="{StaticResource GhostButton}"/>
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
