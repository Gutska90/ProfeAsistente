<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppEducativa.Maui.ViewModels.Documents"
             xmlns:dto="clr-namespace:AppEducativa.Shared.Dtos;assembly=AppEducativa.Shared"
             x:Class="AppEducativa.Maui.Views.Documents.AssessmentSpecificationPage"
             x:DataType="vm:AssessmentSpecificationViewModel"
             Title="Tabla de especificaciones">
    <VerticalStackLayout Padding="16" Spacing="10">
        <Label Text="{Binding MensajeEstado}" />
        <CollectionView ItemsSource="{Binding Rows}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:AssessmentSpecificationRowDto">
                    <Border Stroke="#DDD" Padding="10" Margin="0,0,0,8">
                        <VerticalStackLayout>
                            <Label Text="{Binding IndicatorDescription}" FontAttributes="Bold" LineBreakMode="WordWrap" />
                            <Label Text="{Binding BloomLevel, StringFormat='Bloom: {0}'}" FontSize="12" />
                            <Label Text="{Binding ItemCount, StringFormat='Ítems: {0}'}" FontSize="12" />
                            <Label Text="{Binding WeightPercentage, StringFormat='Peso: {0}%'}" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
