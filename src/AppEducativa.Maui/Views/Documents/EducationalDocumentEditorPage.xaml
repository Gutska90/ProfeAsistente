<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppEducativa.Maui.ViewModels.Documents"
             xmlns:dto="clr-namespace:AppEducativa.Shared.Dtos;assembly=AppEducativa.Shared"
             x:Class="AppEducativa.Maui.Views.Documents.EducationalDocumentEditorPage"
             x:Name="RootPage"
             x:DataType="vm:EducationalDocumentEditorViewModel"
             Title="Editor de material">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">
            <Label Text="{Binding MensajeEstado}" FontSize="13" LineBreakMode="WordWrap" />
            <Label Text="{Binding CurriculumRefs}" FontSize="12" TextColor="#555" />
            <Label Text="{Binding Status, StringFormat='Estado: {0}'}" FontSize="12" />
            <Label Text="Este material fue creado con una configuración anterior de la clase."
                   TextColor="#E65100" FontAttributes="Bold" FontSize="12"
                   IsVisible="{Binding IsOutdated}" />

            <Label Text="Título" FontAttributes="Bold" />
            <Entry Text="{Binding Title}" />
            <Label Text="Instrucciones" FontAttributes="Bold" />
            <Editor Text="{Binding Instructions}" AutoSize="TextChanges" MinimumHeightRequest="70" />
            <Label Text="{Binding TotalPoints, StringFormat='Puntaje total: {0}'}" />
            <Label Text="{Binding Duration, StringFormat='Duración: {0} min'}" />

            <FlexLayout Wrap="Wrap">
                <Button Text="Guardar" Command="{Binding GuardarCommand}" BackgroundColor="#4A7C59" TextColor="White" Margin="0,0,8,8" />
                <Button Text="Validar" Command="{Binding ValidarCommand}" Margin="0,0,8,8" />
                <Button Text="En revisión" Command="{Binding CambiarEstadoCommand}" CommandParameter="UnderReview" Margin="0,0,8,8" />
                <Button Text="Revisado" Command="{Binding CambiarEstadoCommand}" CommandParameter="Reviewed" Margin="0,0,8,8" />
                <Button Text="Finalizar" Command="{Binding CambiarEstadoCommand}" CommandParameter="Final" BackgroundColor="#2F5D8C" TextColor="White" Margin="0,0,8,8" />
                <Button Text="Vista estudiante" Command="{Binding VistaEstudianteCommand}" Margin="0,0,8,8" />
                <Button Text="Vista docente" Command="{Binding VistaDocenteCommand}" Margin="0,0,8,8" />
                <Button Text="Comparar versiones" Command="{Binding CompararCommand}" Margin="0,0,8,8" />
                <Button Text="Exportar DOCX" Command="{Binding ExportarCommand}" CommandParameter="Student"
                        BackgroundColor="#2F5D8C" TextColor="White" Margin="0,0,8,8" />
            </FlexLayout>

            <Label Text="Vista estudiante (sin respuestas)" FontAttributes="Bold" />
            <Label Text="{Binding StudentPreview}" FontSize="12" LineBreakMode="WordWrap" />
            <Label Text="{Binding ComparisonText}" FontSize="12" TextColor="#333" LineBreakMode="WordWrap" />

            <Label Text="Ítems" FontAttributes="Bold" FontSize="16" Margin="0,8,0,0" />
            <CollectionView ItemsSource="{Binding Items}" HeightRequest="420">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:EducationalItemDto">
                        <Border Stroke="#DDD" Padding="10" Margin="0,0,0,8">
                            <VerticalStackLayout Spacing="4">
                                <Label FontAttributes="Bold"
                                       Text="{Binding Order, StringFormat='Ítem {0}'}" />
                                <Label Text="{Binding Statement}" FontSize="12" LineBreakMode="WordWrap" />
                                <Label FontSize="11" TextColor="#666"
                                       Text="{Binding ItemType, StringFormat='Tipo: {0}'}" />
                                <Label FontSize="11" TextColor="#666"
                                       Text="{Binding Points, StringFormat='Puntos: {0}'}" />
                                <Label Text="{Binding ExpectedAnswer}" FontSize="11" TextColor="#2E7D32" />
                                <Button Text="Regenerar ítem"
                                        Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.RegenerarItemCommand}"
                                        CommandParameter="{Binding .}"
                                        FontSize="11" HeightRequest="36" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Tabla de especificaciones" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding Specs}" HeightRequest="140">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:AssessmentSpecificationRowDto">
                        <Label FontSize="12" LineBreakMode="WordWrap">
                            <Label.Text>
                                <MultiBinding StringFormat="{}{0}% · {1} · {2} ítems">
                                    <Binding Path="WeightPercentage" />
                                    <Binding Path="BloomLevel" />
                                    <Binding Path="ItemCount" />
                                </MultiBinding>
                            </Label.Text>
                        </Label>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
