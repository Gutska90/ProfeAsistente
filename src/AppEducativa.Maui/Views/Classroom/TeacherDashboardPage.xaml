<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppEducativa.Maui.ViewModels.Classroom"
             xmlns:dto="clr-namespace:AppEducativa.Shared.Dtos;assembly=AppEducativa.Shared"
             x:Class="AppEducativa.Maui.Views.Classroom.TeacherDashboardPage"
             x:DataType="vm:TeacherDashboardViewModel"
             Title="Inicio">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="Hoy en el aula" Style="{StaticResource TitleLabel}"/>
            <Label Text="{Binding Dashboard.InstitutionName}" Style="{StaticResource CaptionLabel}"/>
            <Label Text="{Binding MensajeEstado}" Style="{StaticResource CaptionLabel}"/>
            <Label Text="{Binding SyncStatus}" Style="{StaticResource CaptionLabel}"/>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Label Text="{Binding Dashboard.ActivePlannings}" FontSize="22" FontAttributes="Bold"/>
                        <Label Text="Planificaciones" Style="{StaticResource CaptionLabel}"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Label Text="{Binding Dashboard.PendingClasses}" FontSize="22" FontAttributes="Bold"/>
                        <Label Text="Clases pendientes" Style="{StaticResource CaptionLabel}"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Label Text="{Binding Dashboard.OpenCoverageAlerts}" FontSize="22" FontAttributes="Bold"/>
                        <Label Text="Alertas OA" Style="{StaticResource CaptionLabel}"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Label Text="{Binding Dashboard.StudentsWithSupportPlans}" FontSize="22" FontAttributes="Bold"/>
                        <Label Text="PIE / DUA" Style="{StaticResource CaptionLabel}"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Label Text="Próximas clases" Style="{StaticResource SectionLabel}" Margin="0"/>
            <CollectionView ItemsSource="{Binding Dashboard.NextClasses}" HeightRequest="240">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:UpcomingClassDto">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenClassCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding PlanningName}" FontAttributes="Bold"/>
                                <Label Text="{Binding ObjectiveCode, StringFormat='OA {0}'}" Style="{StaticResource CaptionLabel}"/>
                                <Label Text="Toque para abrir" FontSize="11" TextColor="{StaticResource Primary}"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Mis planificaciones" Command="{Binding OpenPlanningsCommand}"/>
            <Button Text="Nómina y PIE" Command="{Binding OpenRosterCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Text="Sincronizar ahora" Command="{Binding SyncNowCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Text="Actualizar" Command="{Binding LoadCommand}" Style="{StaticResource GhostButton}"/>
            <Label Style="{StaticResource CaptionLabel}"
                   Text="Apoyo a Bases Curriculares, DUA y Decreto 83. No reemplaza SIGE ni el libro de clases oficial."/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
