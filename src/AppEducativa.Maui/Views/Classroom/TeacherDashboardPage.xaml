<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppEducativa.Maui.ViewModels.Classroom"
             xmlns:dto="clr-namespace:AppEducativa.Shared.Dtos;assembly=AppEducativa.Shared"
             x:Class="AppEducativa.Maui.Views.Classroom.TeacherDashboardPage"
             x:DataType="vm:TeacherDashboardViewModel"
             Title="Hoy">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="{Binding Dashboard.Greeting}" Style="{StaticResource TitleLabel}"/>
            <Label Text="{Binding MensajeEstado}" Style="{StaticResource CaptionLabel}"/>
            <Label Text="{Binding SyncStatus}" Style="{StaticResource CaptionLabel}"/>

            <Label Text="Hoy" Style="{StaticResource SectionLabel}" Margin="0"/>
            <Label Text="No hay clases para hoy. Revise Mis cursos o las próximas clases."
                   Style="{StaticResource CaptionLabel}"
                   IsVisible="{Binding HasTodayClasses, Converter={StaticResource InvertedBoolConverter}}"/>
            <CollectionView ItemsSource="{Binding Dashboard.TodayClasses}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:UpcomingClassDto">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding TitleLine}" FontAttributes="Bold" FontSize="16"/>
                                <Label Text="{Binding UnitName}" Style="{StaticResource CaptionLabel}"/>
                                <Label Text="{Binding ObjectiveCode, StringFormat='OA {0}'}" Style="{StaticResource CaptionLabel}"/>
                                <Button Text="Preparar clase"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.PrepareClassCommand}"
                                        CommandParameter="{Binding .}"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Pendientes" Style="{StaticResource SectionLabel}"/>
            <CollectionView ItemsSource="{Binding Dashboard.PendingItems}" HeightRequest="140" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:TeacherPendingItemDto">
                        <Label Text="{Binding Text, StringFormat='• {0}'}" Margin="0,0,0,6"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Próximas clases" Style="{StaticResource SectionLabel}"/>
            <CollectionView ItemsSource="{Binding Dashboard.NextClasses}" HeightRequest="180" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:UpcomingClassDto">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenClassCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding TitleLine}" FontAttributes="Bold"/>
                                <Label Text="{Binding Date, StringFormat='{0:dd-MM-yyyy}'}" Style="{StaticResource CaptionLabel}"/>
                                <Label Text="{Binding ObjectiveCode, StringFormat='OA {0}'}" Style="{StaticResource CaptionLabel}"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Mis cursos" Command="{Binding OpenCoursesCommand}"/>
            <Button Text="Planificaciones" Command="{Binding OpenPlanningsCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Text="Sincronizar ahora" Command="{Binding SyncNowCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Text="Actualizar" Command="{Binding LoadCommand}" Style="{StaticResource GhostButton}"/>
            <Label Style="{StaticResource CaptionLabel}"
                   Text="Apoyo a Bases Curriculares. No reemplaza SIGE ni el libro de clases oficial."/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
