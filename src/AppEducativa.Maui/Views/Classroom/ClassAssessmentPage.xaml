<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppEducativa.Maui.ViewModels.Classroom"
             xmlns:dto="clr-namespace:AppEducativa.Shared.Dtos;assembly=AppEducativa.Shared"
             x:Class="AppEducativa.Maui.Views.Classroom.ClassAssessmentPage"
             x:DataType="vm:ClassAssessmentViewModel"
             Title="Evaluación">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Evaluación de la clase" Style="{StaticResource TitleLabel}"/>
            <Label Text="{Binding OaHeader}" Style="{StaticResource CaptionLabel}" LineBreakMode="WordWrap"/>
            <Label Style="{StaticResource CaptionLabel}"
                   Text="Formativa o sumativa alineada al OA. Registro de apoyo; no reemplaza el libro de clases."/>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Nueva evaluación" FontAttributes="Bold"/>
                    <Entry Text="{Binding NewName}" Placeholder="Nombre (ticket, prueba, etc.)"/>
                    <Label Text="Propósito" FontSize="13"/>
                    <CollectionView ItemsSource="{Binding PurposeNames}" SelectedItem="{Binding PurposeName}"
                                    SelectionMode="Single" HeightRequest="48">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeThickness="1" Stroke="#CCC" Padding="12,8"
                                        StrokeShape="RoundRectangle 8" BackgroundColor="#F7F7F7">
                                    <Label Text="{Binding .}"/>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Editor Text="{Binding Criteria}" HeightRequest="70" Placeholder="Criterios / indicadores"/>
                    <Button Text="Crear evaluación" Command="{Binding CreateCommand}"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="De esta clase" Style="{StaticResource SectionLabel}"/>
            <CollectionView ItemsSource="{Binding Assessments}" SelectedItem="{Binding Selected}"
                            SelectionMode="Single" HeightRequest="120">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:LearningAssessmentDto">
                        <VerticalStackLayout Padding="6">
                            <Label Text="{Binding Name}" FontAttributes="Bold"/>
                            <Label FontSize="12" TextColor="#555">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0:dd/MM/yyyy} · OA {1}">
                                        <Binding Path="Date"/>
                                        <Binding Path="ObjectiveCode"/>
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Puntajes de la nómina" FontAttributes="Bold"/>
            <CollectionView ItemsSource="{Binding Scores}" HeightRequest="240">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ScoreRow">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Name}" FontAttributes="Bold"/>
                                <Entry Placeholder="Puntaje (opcional)" Keyboard="Numeric" Text="{Binding ScoreText}"/>
                                <Label Text="Nivel de logro" FontSize="12"/>
                                <CollectionView ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AchievementLevels}"
                                                SelectedItem="{Binding AchievementLevel}"
                                                SelectionMode="Single" HeightRequest="44">
                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="6"/>
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Border StrokeThickness="1" Stroke="#CCC" Padding="10,6"
                                                    StrokeShape="RoundRectangle 8" BackgroundColor="#F7F7F7">
                                                <Label Text="{Binding .}" FontSize="12"/>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                                <Entry Placeholder="Retroalimentación" Text="{Binding Feedback}"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Button Text="Guardar puntajes" Command="{Binding SaveScoresCommand}"/>

            <Label Text="Lectura por OA" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding ReadingSummary}" LineBreakMode="WordWrap"/>
                    <Label Text="{Binding LevelCounts}" Style="{StaticResource CaptionLabel}"/>
                    <CollectionView ItemsSource="{Binding IndicatorLines}" HeightRequest="72">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Label Text="{Binding .}" Style="{StaticResource CaptionLabel}"/>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Label Text="Tabla de especificaciones" FontAttributes="Bold"
                           IsVisible="{Binding HasSpecification}"/>
                    <CollectionView ItemsSource="{Binding SpecRows}" HeightRequest="100"
                                    IsVisible="{Binding HasSpecification}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dto:AssessmentSpecificationRowDto">
                                <Label FontSize="12" LineBreakMode="WordWrap">
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}{0}% · {1} · {2} ítems">
                                            <Binding Path="WeightPercentage"/>
                                            <Binding Path="BloomLevel"/>
                                            <Binding Path="ItemCount"/>
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Button Text="Ver tabla completa" Command="{Binding VerEspecificacionesCommand}"
                            Style="{StaticResource GhostButton}" IsVisible="{Binding HasSpecification}"/>
                    <Label Text="Estudiantes que necesitan apoyo" FontAttributes="Bold"
                           IsVisible="{Binding NeedsReinforcement}"/>
                    <CollectionView ItemsSource="{Binding SupportStudents}" HeightRequest="80"
                                    IsVisible="{Binding NeedsReinforcement}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Label Text="{Binding .}" FontSize="13"/>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Button Text="Crear refuerzo para este OA" Command="{Binding CrearRefuerzoCommand}"/>

            <Label Text="{Binding MensajeEstado}" Style="{StaticResource CaptionLabel}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
