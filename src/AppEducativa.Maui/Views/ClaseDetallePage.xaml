<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppEducativa.Maui.ViewModels"
             xmlns:dto="clr-namespace:AppEducativa.Shared.Dtos;assembly=AppEducativa.Shared"
             x:Class="AppEducativa.Maui.Views.ClaseDetallePage"
             x:DataType="vm:ClaseDetalleViewModel"
             Title="Clase">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="{Binding TituloClase}" Style="{StaticResource TitleLabel}"/>
            <Label Text="{Binding SubtituloClase}" Style="{StaticResource CaptionLabel}"/>
            <HorizontalStackLayout Spacing="10">
                <Border BackgroundColor="{Binding ChipColor}" Padding="10,4" StrokeThickness="0"
                        StrokeShape="RoundRectangle 8">
                    <Label Text="{Binding NivelBloomSeleccionado}" TextColor="White" FontAttributes="Bold" />
                </Border>
                <Label Text="{Binding MensajeEstado}" Style="{StaticResource CaptionLabel}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Objetivo de aprendizaje" FontAttributes="Bold"/>
                    <Label Text="{Binding ResumenOa}" LineBreakMode="WordWrap"/>
                    <Label Text="{Binding IndicadoresTexto}" Style="{StaticResource CaptionLabel}"/>
                    <Button Text="Cambiar OA / Bloom" Command="{Binding ToggleEditarCurriculoCommand}"
                            Style="{StaticResource GhostButton}"/>
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding MostrarEditarCurriculo}">
                        <Label Text="OA" FontSize="13"/>
                        <CollectionView ItemsSource="{Binding Objetivos}" SelectedItem="{Binding OaSeleccionado}"
                                        SelectionMode="Single" HeightRequest="120">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="dto:ObjetivoAprendizajeDto">
                                    <Label Text="{Binding Codigo}" Padding="8,6"/>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Label Text="{Binding OaSeleccionado.Descripcion}" Style="{StaticResource CaptionLabel}"/>
                        <Label Text="Bloom" FontSize="13"/>
                        <CollectionView ItemsSource="{Binding NivelesBloom}" SelectedItem="{Binding NivelBloomSeleccionado}"
                                        SelectionMode="Single" HeightRequest="100">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding .}" Padding="8,6"/>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Button Text="Guardar cambios curriculares" Command="{Binding GuardarClaseCommand}"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="Asistente" Style="{StaticResource SectionLabel}" Margin="0"/>
            <Label Text="¿Qué quieres preparar para esta clase?" Style="{StaticResource CaptionLabel}"/>

            <Button Text="Planificar clase" Command="{Binding PlanificarClaseCommand}"/>
            <Button Text="Crear guía" Command="{Binding CrearGuiaCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Text="Crear actividad" Command="{Binding CrearActividadCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Text="Crear evaluación" Command="{Binding CrearEvaluacionMaterialCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Text="Crear ticket de salida" Command="{Binding CrearTicketCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Text="Adaptar material" Command="{Binding AdaptarMaterialCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Text="Ver materiales de la clase" Command="{Binding AbrirMaterialesEducativosCommand}" Style="{StaticResource GhostButton}"/>

            <!-- Planificar: momentos -->
            <VerticalStackLayout Spacing="10" IsVisible="{Binding MostrarPlanificacion}">
                <Label Text="Momentos de la clase" Style="{StaticResource SectionLabel}"/>
                <Button Text="Generar Inicio / Desarrollo / Cierre" Command="{Binding GenerarEstructuraCommand}"/>
                <Button Text="Configurar estructura avanzada" Command="{Binding ConfigurarGenerarEstructuraCommand}"
                        Style="{StaticResource GhostButton}"/>
                <Label Text="{Binding EstructuraEstado}" Style="{StaticResource CaptionLabel}"
                       IsVisible="{Binding TieneEstructuraAvanzada}"/>
                <Label Text="Inicio" FontAttributes="Bold" FontSize="13"/>
                <Editor Text="{Binding DescripcionInicio}" AutoSize="TextChanges" MinimumHeightRequest="72"/>
                <Label Text="Desarrollo" FontAttributes="Bold" FontSize="13"/>
                <Editor Text="{Binding DescripcionDesarrollo}" AutoSize="TextChanges" MinimumHeightRequest="88"/>
                <Label Text="Cierre" FontAttributes="Bold" FontSize="13"/>
                <Editor Text="{Binding DescripcionCierre}" AutoSize="TextChanges" MinimumHeightRequest="72"/>
                <Button Text="Guardar planificación" Command="{Binding GuardarClaseCommand}"/>
            </VerticalStackLayout>

            <!-- Adaptar: DUA práctico -->
            <VerticalStackLayout Spacing="10" IsVisible="{Binding MostrarAdaptar}">
                <Label Text="Adaptar material" Style="{StaticResource SectionLabel}"/>
                <Label Style="{StaticResource CaptionLabel}"
                       Text="Atajos prácticos (DUA / Decreto 83). No es un módulo aparte."/>
                <Button Text="Simplificar instrucciones" Command="{Binding AdaptarSimplificarCommand}"
                        Style="{StaticResource SecondaryButton}"/>
                <Button Text="Versión con mayor andamiaje" Command="{Binding AdaptarAndamiajeCommand}"
                        Style="{StaticResource SecondaryButton}"/>
                <Button Text="Agregar apoyo visual (DUA)" Command="{Binding AdaptarApoyoVisualCommand}"
                        Style="{StaticResource SecondaryButton}"/>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Estrategias DUA de esta clase" FontAttributes="Bold"/>
                        <CollectionView ItemsSource="{Binding DuaStrategies}" HeightRequest="100">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DuaStrategyRow">
                                    <VerticalStackLayout Padding="0,4">
                                        <Label Text="{Binding PrincipleName}" FontAttributes="Bold" FontSize="12"/>
                                        <Label Text="{Binding Strategy}" Style="{StaticResource CaptionLabel}"/>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <CollectionView ItemsSource="{Binding DuaPrincipleNames}"
                                        SelectedItem="{Binding DuaPrincipleSeleccionado}"
                                        SelectionMode="Single" HeightRequest="90">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding .}" Padding="8,6"/>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Editor Text="{Binding DuaEstrategia}" Placeholder="Estrategia DUA de hoy" HeightRequest="64"/>
                        <Button Text="Agregar DUA" Command="{Binding AgregarDuaCommand}"
                                Style="{StaticResource SecondaryButton}"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <Label Text="En el aula" Style="{StaticResource SectionLabel}"/>
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Button Text="Asistencia" Command="{Binding AbrirAsistenciaCommand}" Style="{StaticResource SecondaryButton}"/>
                <Button Grid.Column="1" Text="Puntajes" Command="{Binding AbrirEvaluacionCommand}"
                        Style="{StaticResource SecondaryButton}"/>
                <Button Grid.Row="1" Text="Guardar" Command="{Binding GuardarClaseCommand}"/>
                <Button Grid.Row="1" Grid.Column="1" Text="Clase realizada" Command="{Binding CompletarClaseCommand}"/>
            </Grid>

            <Button Text="Herramientas avanzadas" Command="{Binding ToggleHerramientasCommand}"
                    Style="{StaticResource GhostButton}"/>
            <VerticalStackLayout Spacing="10" IsVisible="{Binding MostrarHerramientasAvanzadas}">
                <Label Text="Exportar, estructura avanzada. El material legado redirige al flujo actual (Guía/Actividad/Prueba)."
                       Style="{StaticResource CaptionLabel}"/>
                <Button Text="Ver estructura avanzada" Command="{Binding VerEstructuraActualCommand}"
                        IsVisible="{Binding TieneEstructuraAvanzada}" Style="{StaticResource SecondaryButton}"/>
                <Button Text="Exportar clase DOCX" Command="{Binding ExportarClaseDocxCommand}"
                        Style="{StaticResource SecondaryButton}"/>
                <Button Text="Generar material (flujo actual)" Command="{Binding GenerarMaterialCommand}"
                        Style="{StaticResource SecondaryButton}"/>
                <Button Text="Ir a materiales de la clase" Command="{Binding AbrirMaterialesEducativosCommand}"
                        Style="{StaticResource SecondaryButton}"/>
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
