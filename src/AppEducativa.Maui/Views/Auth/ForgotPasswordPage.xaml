<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppEducativa.Maui.ViewModels.Auth"
             x:Class="AppEducativa.Maui.Views.Auth.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel"
             Title="Recuperar contraseña">
    <VerticalStackLayout Padding="24" Spacing="12">
        <Entry Placeholder="Usuario o correo" Text="{Binding UserNameOrEmail}"/>
        <Button Text="Solicitar" Command="{Binding SubmitCommand}"/>
        <Label Text="{Binding MensajeEstado}"/>
        <Label Text="{Binding DevelopmentToken}" FontSize="12"/>
    </VerticalStackLayout>
</ContentPage>
