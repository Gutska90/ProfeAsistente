<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppEducativa.Maui.Views.Institutions.InstitutionSelectorPage"
             Title="Establecimiento">
    <VerticalStackLayout Padding="16" Spacing="8">
        <Label Text="Seleccione el establecimiento activo. Se enviará como X-Institution-Id."/>
        <CollectionView x:Name="List" SelectionMode="Single" HeightRequest="280"/>
        <Button Text="Continuar" Clicked="OnContinue"/>
    </VerticalStackLayout>
</ContentPage>
