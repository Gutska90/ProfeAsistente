<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppEducativa.Maui.ViewModels"
             x:Class="AppEducativa.Maui.Views.PlanificacionDetallePage"
             x:DataType="vm:PlanificacionDetalleViewModel"
             Title="Planificación">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="12">
        <VerticalStackLayout Spacing="8">
            <Label Text="{Binding Planificacion.Nombre}" Style="{StaticResource TitleLabel}" />
            <Label Text="{Binding Planificacion.Asignatura}" />
            <Label Text="{Binding Planificacion.Unidad}" Style="{StaticResource CaptionLabel}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Agregar clase" Command="{Binding AgregarClaseCommand}" />
                <Button Grid.Column="1" Text="Calendario" Command="{Binding CalendarioCommand}"
                        Style="{StaticResource SecondaryButton}" />
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Secuencia" Command="{Binding SecuenciaCommand}" Style="{StaticResource GhostButton}" />
                <Button Grid.Column="1" Text="Cobertura" Command="{Binding CoberturaCommand}" Style="{StaticResource GhostButton}" />
            </Grid>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Clases}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ClaseFilaViewModel">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AbrirClaseCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="8">
                            <Label Text="{Binding Numero}" VerticalOptions="Center" FontAttributes="Bold" FontSize="18" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding OaTexto}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding FechaTexto}" Style="{StaticResource CaptionLabel}" />
                                <Label Text="{Binding MaterialFlags}" FontSize="12" TextColor="#666" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2" BackgroundColor="{Binding ChipColor}" Padding="8,4"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 8" VerticalOptions="Center">
                                <Label Text="{Binding NivelBloom}" TextColor="White" FontSize="11" FontAttributes="Bold" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding MensajeEstado}" Style="{StaticResource CaptionLabel}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Exportar" Command="{Binding ExportarCommand}" Style="{StaticResource GhostButton}" />
                <Button Grid.Column="1" Text="Actualizar" Command="{Binding CargarCommand}" Style="{StaticResource GhostButton}" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
