<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppEducativa.Maui.ViewModels.Exports"
             x:Class="AppEducativa.Maui.Views.Exports.ExportProgressPage"
             x:DataType="vm:ExportProgressViewModel"
             Title="Progreso de exportación">
    <VerticalStackLayout Padding="16" Spacing="12">
        <Label Text="{Binding StatusText}" FontAttributes="Bold" FontSize="16" />
        <Label Text="{Binding MensajeEstado}" LineBreakMode="WordWrap" />
        <Button Text="Reintentar descarga" Command="{Binding DescargarYGuardarCommand}" />
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
    </VerticalStackLayout>
</ContentPage>
