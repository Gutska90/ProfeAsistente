<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppEducativa.Maui.ViewModels.Admin"
             xmlns:dto="clr-namespace:AppEducativa.Shared.Dtos;assembly=AppEducativa.Shared"
             x:Class="AppEducativa.Maui.Views.Admin.CurriculumImportDetailPage"
             x:DataType="vm:CurriculumImportDetailViewModel"
             Title="Detalle de importación">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">
            <Label Text="{Binding Estado}" FontSize="20" FontAttributes="Bold" />
            <Label Text="{Binding Resumen}" FontSize="13" />
            <Label Text="{Binding MensajeEstado}" FontSize="12" TextColor="#333" LineBreakMode="WordWrap" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Label Text="Pipeline" FontAttributes="Bold" Margin="0,8,0,0" />
            <FlexLayout Wrap="Wrap" JustifyContent="Start">
                <Button Text="Process" Command="{Binding ProcesarCommand}" Margin="0,0,8,8" />
                <Button Text="Download" Command="{Binding DescargarCommand}" Margin="0,0,8,8" />
                <Button Text="Extract" Command="{Binding ExtraerCommand}" Margin="0,0,8,8" />
                <Button Text="Validate" Command="{Binding ValidarCommand}" Margin="0,0,8,8" />
                <Button Text="Vista previa" Command="{Binding VerPreviewCommand}" Margin="0,0,8,8" />
            </FlexLayout>

            <Label Text="Revisión" FontAttributes="Bold" />
            <FlexLayout Wrap="Wrap">
                <Button Text="Iniciar revisión" Command="{Binding IniciarRevisionCommand}" BackgroundColor="#00695C" TextColor="White" Margin="0,0,8,8" />
                <Button Text="Aprobar" Command="{Binding AprobarCommand}" BackgroundColor="#2E7D32" TextColor="White" Margin="0,0,8,8" />
                <Button Text="Rechazar" Command="{Binding RechazarCommand}" BackgroundColor="#C62828" TextColor="White" Margin="0,0,8,8" />
                <Button Text="Importar a SQLite" Command="{Binding ImportarCommand}" BackgroundColor="#1565C0" TextColor="White" Margin="0,0,8,8" />
            </FlexLayout>

            <Label Text="Issues" FontAttributes="Bold" Margin="0,8,0,0" />
            <CollectionView ItemsSource="{Binding Issues}" HeightRequest="160">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:ValidationIssueDto">
                        <VerticalStackLayout Padding="0,2">
                            <Label Text="{Binding Severity}" FontSize="11" FontAttributes="Bold" />
                            <Label Text="{Binding Message}" FontSize="12" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Diff" FontAttributes="Bold" />
            <Editor Text="{Binding DiffJson}" AutoSize="TextChanges" IsReadOnly="True" MinimumHeightRequest="120" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
