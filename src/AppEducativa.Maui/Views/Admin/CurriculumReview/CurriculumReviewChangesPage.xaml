<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppEducativa.Maui.ViewModels.Admin.CurriculumReview"
             xmlns:dto="clr-namespace:AppEducativa.Shared.Dtos;assembly=AppEducativa.Shared"
             x:Class="AppEducativa.Maui.Views.Admin.CurriculumReview.CurriculumReviewChangesPage"
             x:DataType="vm:CurriculumReviewChangesViewModel"
             Title="Historial de cambios">

    <VerticalStackLayout Padding="16" Spacing="10">
        <Label Text="{Binding MensajeEstado}" FontSize="12" LineBreakMode="WordWrap" />
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        <Button Text="Actualizar" Command="{Binding CargarCommand}" />

        <CollectionView ItemsSource="{Binding Changes}" VerticalOptions="FillAndExpand">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:ReviewChangeDto">
                    <VerticalStackLayout Padding="0,6" Spacing="2">
                        <Label Text="{Binding ChangedAt}" FontSize="11" TextColor="#555" />
                        <Label Text="{Binding EntityType}" FontSize="12" FontAttributes="Bold" />
                        <Label Text="{Binding FieldName}" FontSize="12" />
                        <Label Text="{Binding PreviousValue, StringFormat='Antes: {0}'}" FontSize="11" LineBreakMode="WordWrap" />
                        <Label Text="{Binding NewValue, StringFormat='Después: {0}'}" FontSize="11" LineBreakMode="WordWrap" />
                        <Label Text="{Binding ChangeType}" FontSize="11" TextColor="#666" />
                        <Label Text="{Binding IsReverted, StringFormat='Revertido: {0}'}" FontSize="11" />
                        <BoxView HeightRequest="1" Color="#DDD" Margin="0,4,0,0" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
