<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppEducativa.Maui.ViewModels.Admin.CurriculumReview"
             x:Class="AppEducativa.Maui.Views.Admin.CurriculumReview.CurriculumReviewObjectivesPage"
             x:DataType="vm:CurriculumReviewObjectivesViewModel"
             Title="Objetivos de aprendizaje">

    <VerticalStackLayout Padding="16" Spacing="10">
        <Label Text="{Binding MensajeEstado}" FontSize="12" LineBreakMode="WordWrap" />
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        <Label Text="Filtro" FontSize="12" />
        <Picker ItemsSource="{Binding Filtros}"
                SelectedItem="{Binding FiltroSeleccionado}"
                Title="Filtro" />

        <Entry Placeholder="Buscar por código o texto"
               Text="{Binding Busqueda}" />

        <Button Text="Actualizar" Command="{Binding CargarCommand}" />

        <CollectionView ItemsSource="{Binding Objetivos}"
                        SelectionMode="None"
                        VerticalOptions="FillAndExpand">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ObjectiveListItem">
                    <Border Stroke="#DDD" Padding="10" Margin="0,0,0,8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CurriculumReviewObjectivesViewModel}}, Path=AbrirDetalleCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="2">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding DecisionText}" FontAttributes="Bold" FontSize="12" />
                                <Label Text="{Binding ModifiedBadge}" FontSize="12" TextColor="#B45309" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding Code}" FontSize="14" FontAttributes="Bold" />
                            <Label Text="{Binding ShortDescription}" FontSize="12" LineBreakMode="WordWrap" />
                            <Label Text="{Binding PageText}" FontSize="11" TextColor="#666" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
