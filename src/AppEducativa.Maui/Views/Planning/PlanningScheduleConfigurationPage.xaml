<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppEducativa.Maui.ViewModels.Planning"
             x:Class="AppEducativa.Maui.Views.Planning.PlanningScheduleConfigurationPage"
             x:DataType="vm:PlanningScheduleConfigurationViewModel"
             Title="Horario">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">
            <Label Text="Configuración de horario" FontSize="22" FontAttributes="Bold"/>
            <Label Text="{Binding MensajeEstado}"/>
            <DatePicker Date="{Binding StartDate}"/>
            <DatePicker Date="{Binding EndDate}"/>
            <HorizontalStackLayout Spacing="12">
                <CheckBox IsChecked="{Binding Monday}"/><Label Text="Lunes" VerticalOptions="Center"/>
                <CheckBox IsChecked="{Binding Wednesday}"/><Label Text="Miércoles" VerticalOptions="Center"/>
                <CheckBox IsChecked="{Binding Friday}"/><Label Text="Viernes" VerticalOptions="Center"/>
            </HorizontalStackLayout>
            <Entry Placeholder="Fecha excluida yyyy-MM-dd" Text="{Binding ExcludedDateText}"/>
            <Entry Placeholder="Motivo" Text="{Binding ExcludedReason}"/>
            <Button Text="Agregar exclusión" Command="{Binding AgregarExclusionCommand}"/>
            <CollectionView ItemsSource="{Binding ExcludedLines}" HeightRequest="80"/>
            <Button Text="Guardar y generar sesiones" Command="{Binding GuardarYGenerarCommand}"/>
            <Button Text="Ver calendario" Command="{Binding IrCalendarioCommand}"/>
            <Button Text="Continuar a secuencia" Command="{Binding IrSecuenciaCommand}"/>
            <Label Text="{Binding SessionCount, StringFormat='Sesiones: {0}'}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
