<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppEducativa.Maui.ViewModels.Planning"
             xmlns:dto="clr-namespace:AppEducativa.Shared.Dtos;assembly=AppEducativa.Shared"
             xmlns:cal="clr-namespace:AppEducativa.Shared.Planning;assembly=AppEducativa.Shared"
             x:Class="AppEducativa.Maui.Views.Planning.PlanningCalendarMonthPage"
             x:DataType="vm:PlanningCalendarMonthViewModel"
             Title="Mes">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">
            <Label Text="Vista mensual" FontSize="22" FontAttributes="Bold"/>
            <Label Text="{Binding MensajeEstado}" FontSize="13" LineBreakMode="WordWrap"/>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Text="‹" Command="{Binding PreviousPeriodCommand}" WidthRequest="48"/>
                <Label Grid.Column="1" Text="{Binding PeriodTitle}" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                <Button Grid.Column="2" Text="›" Command="{Binding NextPeriodCommand}" WidthRequest="48"/>
            </Grid>
            <HorizontalStackLayout Spacing="10">
                <Label Text="L" WidthRequest="36" HorizontalTextAlignment="Center" FontAttributes="Bold"/>
                <Label Text="M" WidthRequest="36" HorizontalTextAlignment="Center" FontAttributes="Bold"/>
                <Label Text="X" WidthRequest="36" HorizontalTextAlignment="Center" FontAttributes="Bold"/>
                <Label Text="J" WidthRequest="36" HorizontalTextAlignment="Center" FontAttributes="Bold"/>
                <Label Text="V" WidthRequest="36" HorizontalTextAlignment="Center" FontAttributes="Bold"/>
                <Label Text="S" WidthRequest="36" HorizontalTextAlignment="Center" FontAttributes="Bold"/>
                <Label Text="D" WidthRequest="36" HorizontalTextAlignment="Center" FontAttributes="Bold"/>
            </HorizontalStackLayout>
            <CollectionView ItemsSource="{Binding MonthDays}" HeightRequest="340">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="7" HorizontalItemSpacing="2" VerticalItemSpacing="2"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="cal:CalendarDayCell">
                        <Border Stroke="#DDD" Padding="4" StrokeThickness="1">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectDayCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding HasSessions}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#E8F5E9"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#A5D6A7"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsCurrentMonth}" Value="False">
                                    <Setter Property="Opacity" Value="0.35"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout>
                                <Label Text="{Binding DayNumber}" FontAttributes="Bold" FontSize="13"/>
                                <Label Text="{Binding Summary}" FontSize="9" TextColor="#2E7D32"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <CollectionView ItemsSource="{Binding DaySessions}" HeightRequest="160">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:PlanningCalendarSessionDto">
                        <Grid ColumnDefinitions="*,Auto" Padding="6">
                            <Label Text="{Binding ObjectiveCode}" VerticalOptions="Center"/>
                            <Button Grid.Column="1" Text="Abrir"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AbrirClaseCommand}"
                                    CommandParameter="{Binding .}"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Button Text="Semana" Command="{Binding OpenWeekPageCommand}"/>
            <Button Text="Horario" Command="{Binding ConfigurarCommand}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
