<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppEducativa.Maui.ViewModels.Planning"
             xmlns:dto="clr-namespace:AppEducativa.Shared.Dtos;assembly=AppEducativa.Shared"
             x:Class="AppEducativa.Maui.Views.Planning.PlanningCoverageDashboardPage"
             x:DataType="vm:PlanningCoverageDashboardViewModel"
             Title="Cobertura">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">
            <Label Text="Cobertura curricular" FontSize="22" FontAttributes="Bold"/>
            <Label Text="{Binding MensajeEstado}"/>
            <Button Text="Cambiar planificada/ejecutada" Command="{Binding ToggleModeCommand}"/>
            <Label Text="{Binding Coverage.AvailableSessions, StringFormat='Sesiones disponibles: {0}'}"/>
            <Label Text="{Binding Coverage.CoveredObjectives, StringFormat='OA cubiertos: {0}'}"/>
            <Label Text="{Binding Coverage.CoveredIndicators, StringFormat='Indicadores cubiertos: {0}'}"/>
            <Label Text="{Binding Coverage.BlockingAlerts, StringFormat='Alertas bloqueantes: {0}'}"/>
            <Label Text="OA" FontAttributes="Bold"/>
            <CollectionView ItemsSource="{Binding Objectives}" HeightRequest="160">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:ObjectiveCoverageDto">
                        <Label Text="{Binding Code}"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Label Text="Matriz" FontAttributes="Bold"/>
            <CollectionView ItemsSource="{Binding MatrixLines}" HeightRequest="180"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
