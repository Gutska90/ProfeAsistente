<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppEducativa.Maui.ViewModels.Planning"
             xmlns:dto="clr-namespace:AppEducativa.Shared.Dtos;assembly=AppEducativa.Shared"
             x:Class="AppEducativa.Maui.Views.Planning.PlanningAlertsPage"
             x:DataType="vm:PlanningAlertsViewModel"
             Title="Alertas">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">
            <Label Text="Alertas de planificación" FontSize="22" FontAttributes="Bold"/>
            <Label Text="{Binding MensajeEstado}"/>
            <Button Text="Actualizar" Command="{Binding CargarCommand}"/>
            <CollectionView ItemsSource="{Binding Alerts}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:PlanningAlertDto">
                        <VerticalStackLayout Padding="6">
                            <Label Text="{Binding AlertCode}" FontAttributes="Bold"/>
                            <Label Text="{Binding Severity}"/>
                            <Label Text="{Binding Message}"/>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
