{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=profeasistente.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Demo": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": [],
    "RestrictInDevelopment": false
  },
  "Gemini": {
    "ApiKeyEnvironmentVariable": "GEMINI_API_KEY",
    "Model": "gemini-2.5-flash",
    "BaseUrl": "https://generativelanguage.googleapis.com",
    "TimeoutSeconds": 60,
    "MaxRetries": 2,
    "Temperature": 0.3,
    "MaxOutputTokens": 5000,
    "EnableGeneration": true,
    "PersistRequestPayloads": true,
    "PromptVersion": "class-structure-v1"
  },
  "AiUsage": {
    "MaximumGenerationsPerClassPerDay": 10,
    "MaximumConcurrentGenerations": 2,
    "MaximumDocumentGenerationsPerClassPerDay": 10,
    "MaximumItemRegenerationsPerDocumentPerDay": 30,
    "ModelPricing": {
      "gemini-2.5-flash": {
        "InputPerMillionUsd": 0.15,
        "OutputPerMillionUsd": 0.60
      },
      "default": {
        "InputPerMillionUsd": 0.15,
        "OutputPerMillionUsd": 0.60
      }
    }
  },
  "Curriculum": {
    "IncludeDemoData": false,
    "SourcesConfigPath": "Configuration/curriculum-sources.json",
    "StorageRoot": "App_Data/Curriculum",
    "MaxDownloadBytes": 26214400
  },
  "Export": {
    "RootPath": "App_Data/Exports",
    "KeepFilesForDays": 30,
    "MaximumFileSizeMb": 50,
    "DeleteExpiredFiles": true,
    "UseBackgroundQueue": false,
    "SynchronousTimeoutSeconds": 90,
    "AllowOutdatedDocuments": false,
    "DefaultFontFamily": "Aptos",
    "TemplateSettingsPath": "Templates/Word/default-template-settings.json"
  },
  "Authentication": {
    "Issuer": "ProfeAsistente.Api",
    "Audience": "ProfeAsistente.Maui",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7,
    "RequireConfirmedEmail": false,
    "MaximumFailedAttempts": 5,
    "LockoutMinutes": 15,
    "AllowDevelopmentSigningKey": true
  },
  "RateLimiting": {
    "LoginRequestsPerMinute": 10,
    "PasswordResetRequestsPerHour": 5,
    "RefreshRequestsPerMinute": 30
  },
  "DevelopmentAuthentication": {
    "Enabled": false,
    "DefaultUserName": ""
  }
}
