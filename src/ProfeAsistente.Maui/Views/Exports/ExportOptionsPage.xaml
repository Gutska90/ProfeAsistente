<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProfeAsistente.Maui.ViewModels.Exports"
             x:Class="ProfeAsistente.Maui.Views.Exports.ExportOptionsPage"
             x:DataType="vm:ExportOptionsViewModel"
             Title="Exportar DOCX">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">
            <Label Text="{Binding MensajeEstado}" FontSize="13" LineBreakMode="WordWrap" />
            <Label Text="Audiencia (Student / Teacher / Administrative)" />
            <Entry Text="{Binding Audience}" />
            <Label Text="Establecimiento" />
            <Entry Text="{Binding SchoolName}" />
            <Label Text="Docente" />
            <Entry Text="{Binding TeacherName}" />
            <Label Text="Curso" />
            <Entry Text="{Binding CourseName}" />
            <HorizontalStackLayout Spacing="8">
                <CheckBox IsChecked="{Binding IncludeCurriculum}" />
                <Label Text="Incluir referencias curriculares" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="8">
                <CheckBox IsChecked="{Binding IncludeAnswerKey}" />
                <Label Text="Incluir clave (solo docente)" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="8">
                <CheckBox IsChecked="{Binding ConfirmOutdated}" />
                <Label Text="Confirmar si está desactualizado" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <FlexLayout Wrap="Wrap">
                <Button Text="Planificación" Command="{Binding ExportarCommand}" CommandParameter="planning" Margin="0,0,8,8" />
                <Button Text="Paquete ZIP" Command="{Binding ExportarCommand}" CommandParameter="package" BackgroundColor="#2F5D8C" TextColor="White" Margin="0,0,8,8" />
                <Button Text="Clase" Command="{Binding ExportarCommand}" CommandParameter="class" Margin="0,0,8,8" />
                <Button Text="Material estudiante" Command="{Binding ExportarCommand}" CommandParameter="document" Margin="0,0,8,8" />
                <Button Text="Clave" Command="{Binding ExportarCommand}" CommandParameter="answerkey" Margin="0,0,8,8" />
                <Button Text="Especificaciones" Command="{Binding ExportarCommand}" CommandParameter="spec" Margin="0,0,8,8" />
            </FlexLayout>
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="Historial de exportaciones" Command="{Binding IrHistorialCommand}" Style="{StaticResource GhostButton}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
