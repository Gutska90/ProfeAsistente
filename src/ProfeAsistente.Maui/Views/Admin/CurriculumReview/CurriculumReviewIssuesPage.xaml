<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProfeAsistente.Maui.ViewModels.Admin.CurriculumReview"
             x:Class="ProfeAsistente.Maui.Views.Admin.CurriculumReview.CurriculumReviewIssuesPage"
             x:DataType="vm:CurriculumReviewIssuesViewModel"
             Title="Problemas">

    <VerticalStackLayout Padding="16" Spacing="10">
        <Label Text="{Binding MensajeEstado}" FontSize="12" LineBreakMode="WordWrap" />
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        <Button Text="Actualizar" Command="{Binding CargarCommand}" />

        <CollectionView ItemsSource="{Binding Issues}" VerticalOptions="FillAndExpand">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:IssueListItem">
                    <VerticalStackLayout Padding="0,6" Spacing="2">
                        <Label FontAttributes="Bold" FontSize="12"
                               Text="{Binding Severity}" />
                        <Label FontSize="12"
                               Text="{Binding Scope}" />
                        <Label FontSize="12"
                               Text="{Binding Entity}" />
                        <Label Text="{Binding Message}" FontSize="12" LineBreakMode="WordWrap" />
                        <BoxView HeightRequest="1" Color="#DDD" Margin="0,4,0,0" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
