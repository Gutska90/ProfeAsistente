<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProfeAsistente.Maui.ViewModels.Admin.CurriculumReview"
             xmlns:dto="clr-namespace:ProfeAsistente.Shared.Dtos;assembly=ProfeAsistente.Shared"
             x:Class="ProfeAsistente.Maui.Views.Admin.CurriculumReview.CurriculumReviewUnitsPage"
             x:DataType="vm:CurriculumReviewUnitsViewModel"
             Title="Unidades">

    <VerticalStackLayout Padding="16" Spacing="10">
        <Label Text="{Binding MensajeEstado}" FontSize="12" LineBreakMode="WordWrap" />
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        <HorizontalStackLayout Spacing="8">
            <Button Text="Actualizar" Command="{Binding CargarCommand}" />
            <Button Text="Ver OA" Command="{Binding IrObjetivosCommand}" />
        </HorizontalStackLayout>

        <CollectionView ItemsSource="{Binding Unidades}" VerticalOptions="FillAndExpand">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:ReviewUnitDto">
                    <VerticalStackLayout Padding="0,6" Spacing="2">
                        <Label FontAttributes="Bold" FontSize="14">
                            <Label.Text>
                                <Binding Path="Number" StringFormat="Unidad {0}" />
                            </Label.Text>
                        </Label>
                        <Label Text="{Binding Name}" FontSize="13" LineBreakMode="WordWrap" />
                        <Label Text="{Binding Decision, StringFormat='Decisión: {0}'}" FontSize="12" />
                        <Label Text="{Binding ObjectiveCount, StringFormat='OA: {0}'}" FontSize="11" TextColor="#555" />
                        <BoxView HeightRequest="1" Color="#DDD" Margin="0,4,0,0" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
