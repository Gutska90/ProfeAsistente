<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProfeAsistente.Maui.ViewModels.Admin.CurriculumReview"
             x:Class="ProfeAsistente.Maui.Views.Admin.CurriculumReview.CurriculumReviewDiffPage"
             x:DataType="vm:CurriculumReviewDiffViewModel"
             Title="Diferencias">

    <VerticalStackLayout Padding="16" Spacing="10">
        <Label Text="{Binding MensajeEstado}" FontSize="12" LineBreakMode="WordWrap" />
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        <Button Text="Actualizar" Command="{Binding CargarCommand}" />

        <CollectionView ItemsSource="{Binding Items}" VerticalOptions="FillAndExpand">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:DiffListItem">
                    <VerticalStackLayout Padding="0,6" Spacing="2">
                        <Label Text="{Binding ChangeType}" FontAttributes="Bold" FontSize="13" />
                        <Label Text="{Binding EntityType}" FontSize="12" />
                        <Label Text="{Binding Code}" FontSize="12" />
                        <Label Text="{Binding FieldsSummary}" FontSize="11" LineBreakMode="WordWrap" TextColor="#444" />
                        <BoxView HeightRequest="1" Color="#DDD" Margin="0,4,0,0" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
