<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProfeAsistente.Maui.ViewModels.Auth"
             x:Class="ProfeAsistente.Maui.Views.Auth.ChangePasswordPage"
             x:DataType="vm:ChangePasswordViewModel"
             Title="Cambiar contraseña">
    <VerticalStackLayout Padding="24" Spacing="12">
        <Entry Placeholder="Contraseña actual" IsPassword="True" Text="{Binding CurrentPassword}"/>
        <Entry Placeholder="Nueva contraseña" IsPassword="True" Text="{Binding NewPassword}"/>
        <Button Text="Guardar" Command="{Binding ChangeCommand}"/>
        <Label Text="{Binding MensajeEstado}"/>
    </VerticalStackLayout>
</ContentPage>
