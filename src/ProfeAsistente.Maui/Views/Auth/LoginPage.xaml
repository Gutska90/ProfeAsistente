<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProfeAsistente.Maui.ViewModels.Auth"
             x:Class="ProfeAsistente.Maui.Views.Auth.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Iniciar sesión">
    <VerticalStackLayout Padding="32" Spacing="16" VerticalOptions="Center" MaximumWidthRequest="420">
        <Label Text="ProfeAsistente" Style="{StaticResource TitleLabel}" HorizontalOptions="Center" FontSize="28"/>
        <Label Text="Asistente de trabajo docente basado en el Currículum Nacional" Style="{StaticResource CaptionLabel}"
               HorizontalTextAlignment="Center" HorizontalOptions="Center"/>
        <Entry Placeholder="Usuario o correo" Text="{Binding UserName}" AutomationId="LoginUser"/>
        <Entry Placeholder="Contraseña" IsPassword="True" Text="{Binding Password}" AutomationId="LoginPassword"/>
        <Button Text="Entrar con usuario de prueba" Command="{Binding DemoLoginCommand}"/>
        <Button Text="Entrar" Command="{Binding LoginCommand}" Style="{StaticResource SecondaryButton}"/>
        <Button Text="Olvidé mi contraseña" Clicked="OnForgotClicked" Style="{StaticResource GhostButton}"/>
        <Label Text="{Binding MensajeEstado}" Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="Center"/>
    </VerticalStackLayout>
</ContentPage>
