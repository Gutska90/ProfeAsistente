<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProfeAsistente.Maui.ViewModels.Documents"
             x:Class="ProfeAsistente.Maui.Views.Documents.EducationalDocumentComparisonPage"
             x:DataType="vm:EducationalDocumentComparisonViewModel"
             Title="Comparar materiales">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">
            <Label Text="{Binding MensajeEstado}" />
            <Label Text="{Binding ComparisonText}" FontSize="13" LineBreakMode="WordWrap" />
            <Button Text="Actualizar" Command="{Binding CargarCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
