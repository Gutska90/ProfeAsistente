<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProfeAsistente.Maui.ViewModels.Classroom"
             xmlns:dto="clr-namespace:ProfeAsistente.Shared.Dtos;assembly=ProfeAsistente.Shared"
             x:Class="ProfeAsistente.Maui.Views.Classroom.CourseRosterPage"
             x:DataType="vm:CourseRosterViewModel"
             Title="Nómina y PIE">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Curso" Style="{StaticResource SectionLabel}" Margin="0"/>
            <CollectionView ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourse}"
                            SelectionMode="Single" HeightRequest="120">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:SchoolCourseDto">
                        <Label Text="{Binding DisplayName}" Padding="10,8"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Inscritos" Style="{StaticResource SectionLabel}"/>
            <Label Text="La asistencia y la evaluación usan esta lista." Style="{StaticResource CaptionLabel}"/>
            <CollectionView ItemsSource="{Binding Roster}" SelectedItem="{Binding SelectedRosterStudent}"
                            SelectionMode="Single" HeightRequest="160">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:RosterStudentDto">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="10">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding DisplayName}" VerticalOptions="Center"/>
                                <Label Text="PIE/DUA" TextColor="{StaticResource Primary}" FontAttributes="Bold"
                                       IsVisible="{Binding HasActiveSupportPlan}" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Nuevo estudiante" FontAttributes="Bold"/>
                    <Entry Placeholder="Nombre" Text="{Binding FirstName}"/>
                    <Entry Placeholder="Apellido" Text="{Binding LastName}"/>
                    <Button Text="Agregar e inscribir" Command="{Binding CreateCommand}"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="Del establecimiento" Style="{StaticResource SectionLabel}"/>
            <CollectionView ItemsSource="{Binding InstitutionStudents}" SelectedItem="{Binding SelectedInstitutionStudent}"
                            SelectionMode="Single" HeightRequest="120">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:StudentDto">
                        <Label Padding="8,6" Text="{Binding DisplayName}"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Button Text="Inscribir al curso" Command="{Binding EnrollSelectedCommand}" Style="{StaticResource SecondaryButton}"/>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Plan PIE / Decreto 83" FontAttributes="Bold"/>
                    <Editor Text="{Binding PieStrategies}" HeightRequest="70"/>
                    <Button Text="Registrar plan" Command="{Binding AddPieCommand}" Style="{StaticResource SecondaryButton}"/>
                </VerticalStackLayout>
            </Border>
            <Label Text="{Binding MensajeEstado}" Style="{StaticResource CaptionLabel}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
