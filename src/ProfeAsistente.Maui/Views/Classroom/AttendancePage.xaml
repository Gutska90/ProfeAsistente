<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProfeAsistente.Maui.ViewModels.Classroom"
             x:Class="ProfeAsistente.Maui.Views.Classroom.AttendancePage"
             x:DataType="vm:AttendanceViewModel"
             Title="Asistencia">
    <VerticalStackLayout Padding="20" Spacing="12">
        <Label Text="Asistencia de la clase" Style="{StaticResource TitleLabel}"/>
        <Label Text="Registro local de apoyo. No reemplaza SIGE." Style="{StaticResource CaptionLabel}"/>
        <CollectionView ItemsSource="{Binding Rows}" HeightRequest="380">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:AttendanceRow">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="10">
                        <HorizontalStackLayout Spacing="10">
                            <CheckBox IsChecked="{Binding Present}"/>
                            <Label Text="{Binding Name}" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Text="Guardar asistencia" Command="{Binding SaveCommand}"/>
        <Label Text="{Binding MensajeEstado}" Style="{StaticResource CaptionLabel}"/>
    </VerticalStackLayout>
</ContentPage>
