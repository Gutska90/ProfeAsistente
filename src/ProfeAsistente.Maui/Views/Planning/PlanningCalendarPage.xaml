<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProfeAsistente.Maui.ViewModels.Planning"
             xmlns:dto="clr-namespace:ProfeAsistente.Shared.Dtos;assembly=ProfeAsistente.Shared"
             xmlns:cal="clr-namespace:ProfeAsistente.Shared.Planning;assembly=ProfeAsistente.Shared"
             x:Class="ProfeAsistente.Maui.Views.Planning.PlanningCalendarPage"
             x:DataType="vm:PlanningCalendarViewModel"
             Title="Calendario">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">
            <Label Text="Calendario de clases" Style="{StaticResource TitleLabel}"/>
            <Label Text="{Binding MensajeEstado}" Style="{StaticResource CaptionLabel}"/>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Text="Mes" Command="{Binding ShowMonthViewCommand}" Style="{StaticResource SecondaryButton}"/>
                <Button Grid.Column="1" Text="Semana" Command="{Binding ShowWeekViewCommand}" Style="{StaticResource SecondaryButton}"/>
                <Button Grid.Column="2" Text="Lista" Command="{Binding ShowListViewCommand}" Style="{StaticResource SecondaryButton}"/>
            </Grid>

            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Text="‹" Command="{Binding PreviousPeriodCommand}" WidthRequest="48"/>
                <Label Grid.Column="1" Text="{Binding PeriodTitle}" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                <Button Grid.Column="2" Text="›" Command="{Binding NextPeriodCommand}" WidthRequest="48"/>
            </Grid>

            <HorizontalStackLayout Spacing="10" IsVisible="{Binding ShowMonth}">
                <Label Text="L" WidthRequest="36" HorizontalTextAlignment="Center" FontAttributes="Bold"/>
                <Label Text="M" WidthRequest="36" HorizontalTextAlignment="Center" FontAttributes="Bold"/>
                <Label Text="X" WidthRequest="36" HorizontalTextAlignment="Center" FontAttributes="Bold"/>
                <Label Text="J" WidthRequest="36" HorizontalTextAlignment="Center" FontAttributes="Bold"/>
                <Label Text="V" WidthRequest="36" HorizontalTextAlignment="Center" FontAttributes="Bold"/>
                <Label Text="S" WidthRequest="36" HorizontalTextAlignment="Center" FontAttributes="Bold"/>
                <Label Text="D" WidthRequest="36" HorizontalTextAlignment="Center" FontAttributes="Bold"/>
            </HorizontalStackLayout>

            <CollectionView ItemsSource="{Binding MonthDays}" IsVisible="{Binding ShowMonth}" HeightRequest="340">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="7" HorizontalItemSpacing="2" VerticalItemSpacing="2"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="cal:CalendarDayCell">
                        <Border Stroke="#DDD" Padding="4" StrokeThickness="1">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectDayCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding HasSessions}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#E8F5E9"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#A5D6A7"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsCurrentMonth}" Value="False">
                                    <Setter Property="Opacity" Value="0.35"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout>
                                <Label Text="{Binding DayNumber}" FontAttributes="Bold" FontSize="13"/>
                                <Label Text="{Binding Summary}" FontSize="9" TextColor="#2E7D32"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <CollectionView ItemsSource="{Binding WeekDays}" IsVisible="{Binding ShowWeek}" HeightRequest="360">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="cal:CalendarDayCell">
                        <Border Stroke="#DDD" Padding="8" Margin="0,0,0,6" StrokeThickness="1">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectDayCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#E8F5E9"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Spacing="2">
                                <Label FontAttributes="Bold">
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}{0} {1}">
                                            <Binding Path="WeekdayName"/>
                                            <Binding Path="DayNumber"/>
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                                <Label Text="{Binding Detail}" FontSize="12" TextColor="#444"
                                       IsVisible="{Binding HasSessions}"/>
                                <Label Text="Sin clase" FontSize="12" TextColor="#888"
                                       IsVisible="{Binding HasSessions, Converter={StaticResource InvertedBoolConverter}}"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <CollectionView ItemsSource="{Binding Sessions}" IsVisible="{Binding ShowList}" HeightRequest="280">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:PlanningCalendarSessionDto">
                        <Grid ColumnDefinitions="40,*,90,Auto" Padding="4">
                            <Label Text="{Binding SessionNumber}"/>
                            <Label Grid.Column="1" Text="{Binding ScheduledDate}"/>
                            <Label Grid.Column="2" Text="{Binding ObjectiveCode}"/>
                            <Button Grid.Column="3" Text="Abrir"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AbrirClaseCommand}"
                                    CommandParameter="{Binding .}"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Clases del día elegido" FontAttributes="Bold"/>
            <CollectionView ItemsSource="{Binding DaySessions}" SelectedItem="{Binding SelectedSession}"
                            SelectionMode="Single" HeightRequest="140">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:PlanningCalendarSessionDto">
                        <Grid ColumnDefinitions="*,Auto,Auto" Padding="4" ColumnSpacing="6">
                            <Label VerticalOptions="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="#"/>
                                        <Span Text="{Binding SessionNumber}"/>
                                        <Span Text="  "/>
                                        <Span Text="{Binding ObjectiveCode}"/>
                                        <Span Text="  "/>
                                        <Span Text="{Binding BloomLevel}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Button Grid.Column="1" Text="Abrir"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AbrirClaseCommand}"
                                    CommandParameter="{Binding .}"/>
                            <Button Grid.Column="2" Text="Cancelar"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CancelarCommand}"
                                    CommandParameter="{Binding .}"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Button Text="Mover sesión elegida a este día" Command="{Binding ReprogramarCommand}"/>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Horario" Command="{Binding ConfigurarCommand}" Style="{StaticResource GhostButton}"/>
                <Button Grid.Column="1" Text="Actualizar" Command="{Binding CargarCommand}" Style="{StaticResource GhostButton}"/>
            </Grid>
            <Label Style="{StaticResource CaptionLabel}"
                   Text="Semana de lunes a domingo. Feriados solo si los carga a mano en Horario."/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
